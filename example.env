# Copy to .env and fill in SVN_PASSWORD for local WordPress.org deploys:
#   cp example.env .env
# Then: npm run deploy:svn   or   npm run release
#
# GitHub Actions uses repository secrets SVN_USERNAME / SVN_PASSWORD (optional SVN_URL).

SVN_USERNAME=zeddotes
SVN_PASSWORD=
SVN_URL=https://plugins.svn.wordpress.org/zeddotes-enhanced-code-block
